# ─── Email ───
RESEND_API_KEY=re_...

# ─── Cache / Queue (P2) ───
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...

# ─── Monitoring ───
SENTRY_DSN=https://...
